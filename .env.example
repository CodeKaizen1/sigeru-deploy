# Copiá este archivo a ".env" (mismo directorio que docker-compose.yml) y
# completá MYSQL_ROOT_PASSWORD con una contraseña propia de esta
# instalación. "docker compose up" la lee sola -- no hace falta tocar
# nada más.
#
# IMPORTANTE: este .env nunca se debe subir a git (ver .gitignore) porque
# va a tener una contraseña real. Completalo solo en la máquina/VM donde
# se levanten los contenedores.
#
# Esta variante de sigeru-deploy levanta su propio contenedor de base de
# datos ("db", MySQL 8) -- no depende de ninguna VM externa.

# Contraseña del usuario root de MySQL dentro del contenedor "db".
# Elegir una propia, no dejar el valor de ejemplo.
MYSQL_ROOT_PASSWORD=cambiar_esta_contrasenia

# Nombre de la base (coincide con el que usan los scripts de docker/init-db)
DB_NAME=SiGeRU
