# Copiá este archivo a ".env" (mismo directorio que docker-compose.yml) y
# completá los 5 valores de abajo con los datos REALES de la VM de base de
# datos externa (la que ya tiene el compañero para la entrega de la UTU).
# "docker compose up" los lee solos -- no hace falta tocar nada más.
#
# IMPORTANTE: este .env nunca se debe subir a git (ver .gitignore) porque
# va a tener una contraseña real. Completalo solo en la máquina/VM donde
# se levanten los contenedores.
#
# Esta variante de sigeru-deploy NO levanta su propio contenedor de base
# de datos: se conecta directo a la VM externa que ya tiene el esquema de
# SiGeRU cargado.

# Host o IP donde se puede alcanzar la VM de base de datos desde donde se
# levanten estos contenedores (ej. una IP de red interna/VPN, o el nombre
# de host que use la VM). Pedírselo al compañero que administra esa VM.
DB_HOST=completar_host_o_ip_de_la_vm

# Puerto donde escucha MySQL en esa VM. 3306 es el puerto estándar de
# MySQL -- dejar este valor salvo que el compañero indique otro.
DB_PORT=3306

# Nombre de la base de datos ya cargada en esa VM.
DB_NAME=SiGeRU

# Usuario y contraseña de MySQL con permisos sobre esa base, tal como los
# haya creado el compañero que administra la VM (no necesariamente "root").
DB_USER=completar_usuario_mysql
DB_PASS=completar_contrasenia_mysql
